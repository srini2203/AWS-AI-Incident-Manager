APP_NAME=aws-ai-incident-triage-agent
APP_ENV=production

AWS_REGION=ap-south-1
AWS_PROFILE=

BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
BEDROCK_MAX_TOKENS=1800
BEDROCK_TEMPERATURE=0.1
BEDROCK_TOP_P=0.9
BEDROCK_RETRY_ATTEMPTS=3
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
BEDROCK_MAX_EVIDENCE_CHARS=30000

ENABLE_BEDROCK_GUARDRAILS=true
BEDROCK_GUARDRAIL_ID=REPLACE_WITH_GUARDRAIL_ID
BEDROCK_GUARDRAIL_VERSION=REPLACE_WITH_GUARDRAIL_VERSION

CLOUDWATCH_LOG_GROUPS=/aws/ec2/three-tier-app,/aws/lambda/three-tier-app
APP_LOG_GROUP=

CLOUDWATCH_LOG_LOOKBACK_MINUTES=15
CLOUDWATCH_LOG_QUERY_TIMEOUT_SECONDS=30
MAX_LOG_ENTRIES=200
MAX_LOG_ENTRY_LENGTH=4000

METRICS_LOOKBACK_MINUTES=15
METRIC_PERIOD_SECONDS=60
MAX_METRIC_DATAPOINTS=100

TARGET_GROUP_ARN=
LOAD_BALANCER_ARN=

SNS_TOPIC_ARN=REPLACE_WITH_SNS_TOPIC_ARN
ENABLE_SNS_NOTIFICATIONS=true

APPROVAL_TABLE_NAME=aws-ai-incident-approvals
APPROVAL_TTL_HOURS=24
APPROVAL_API_URL=REPLACE_WITH_APPROVAL_API_URL
APPROVER_GROUPS=IncidentApprovers

AUDIT_LOG_GROUP=/aws/lambda/aws-ai-incident-triage-agent-audit
AUDIT_LOG_LEVEL=INFO

LAMBDA_TIMEOUT_SECONDS=60
AWS_API_TIMEOUT_SECONDS=10
INVESTIGATION_MAX_CONCURRENCY=4

PROMPT_VERSION=1.0